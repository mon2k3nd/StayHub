<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="create-shared-facilities-tables" author="antigravity">
        <createTable tableName="shared_facilities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)"/>
        </createTable>

        <createTable tableName="room_shared_facilities">
            <column name="facility_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="facility_id"
                                 baseTableName="room_shared_facilities"
                                 constraintName="fk_rsf_facility"
                                 referencedColumnNames="id"
                                 referencedTableName="shared_facilities"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseColumnNames="room_id"
                                 baseTableName="room_shared_facilities"
                                 constraintName="fk_rsf_room"
                                 referencedColumnNames="id"
                                 referencedTableName="rooms"
                                 onDelete="CASCADE"/>
                                 
        <addForeignKeyConstraint baseColumnNames="branch_id"
                                 baseTableName="shared_facilities"
                                 constraintName="fk_sf_branch"
                                 referencedColumnNames="id"
                                 referencedTableName="branches"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
