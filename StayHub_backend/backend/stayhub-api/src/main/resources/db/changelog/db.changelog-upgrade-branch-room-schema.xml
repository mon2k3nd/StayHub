<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="upgrade-branch-room-schema" author="ai">
        <!-- Bảng branches -->
        <addColumn tableName="branches">
            <column name="branch_code" type="VARCHAR(50)">
                <constraints unique="true"/>
            </column>
            <column name="ward_code" type="VARCHAR(20)"/>
            <column name="district_code" type="VARCHAR(20)"/>
            <column name="province_code" type="VARCHAR(20)"/>
            <column name="property_type" type="INT"/>
            <column name="billing_day" type="INT" defaultValueNumeric="25"/>
            <column name="payment_grace_period" type="INT" defaultValueNumeric="5"/>
            <column name="late_fee_percent" type="DECIMAL(5, 2)" defaultValueNumeric="0.0"/>
            <column name="management_type" type="INT"/>
        </addColumn>

        <!-- Bảng rooms -->
        <addColumn tableName="rooms">
            <column name="room_code" type="VARCHAR(50)">
                <constraints unique="true"/>
            </column>
            <column name="floor" type="INT"/>
            <column name="floor_area" type="DECIMAL(5, 2)"/>
            <column name="mezzanine_area" type="DECIMAL(5, 2)"/>
            <column name="base_deposit" type="DOUBLE"/>
            <column name="max_vehicles" type="INT" defaultValueNumeric="2"/>
        </addColumn>

        <!-- Bảng room_devices -->
        <createTable tableName="room_devices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="device_type" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ip_or_mac_address" type="VARCHAR(50)"/>
            <column name="api_token" type="VARCHAR(255)"/>
            <column name="last_recorded_value" type="DECIMAL(10, 2)"/>
            <column name="last_sync_time" type="TIMESTAMP"/>
        </createTable>

        <!-- Bảng room_handovers -->
        <createTable tableName="room_handovers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contract_id" type="BIGINT"/>
            <column name="inspection_time" type="INT"/>
            <column name="wall_condition" type="TEXT"/>
            <column name="plumbing_condition" type="TEXT"/>
            <column name="electrical_condition" type="TEXT"/>
            <column name="attached_images" type="JSONB"/>
        </createTable>

        <!-- Bảng room_service_configs -->
        <createTable tableName="room_service_configs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="custom_price" type="DOUBLE"/>
            <column name="quantity" type="INT" defaultValueNumeric="1"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="room_devices" baseColumnNames="room_id"
                                 constraintName="fk_room_devices_room_id"
                                 referencedTableName="rooms" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="room_handovers" baseColumnNames="room_id"
                                 constraintName="fk_room_handovers_room_id"
                                 referencedTableName="rooms" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="room_service_configs" baseColumnNames="room_id"
                                 constraintName="fk_room_service_configs_room_id"
                                 referencedTableName="rooms" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
