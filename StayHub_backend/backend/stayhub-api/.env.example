# ============================================================
# StayHub - Environment Variables Template
# Sao chép file này thành .env và điền các giá trị thực
# ============================================================

# ---- Database ----
DATABASE_URL=jdbc:postgresql://stayhub-db:5432/stayhub_db
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# ---- JWT Security ----
JWT_SECRET=your_jwt_secret_must_be_at_least_256_bits_long_for_hs256_algorithm

# ---- Email (SMTP) ----
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=prod

# ---- AI/Gemini (nếu có) ----
GEMINI_API_KEY=your_gemini_api_key_here
